# Copy this file to .env and adjust as needed.

# Server
PORT=4000
NODE_ENV=development

# Public URL of this backend once deployed (used only for logging/CORS hints)
PUBLIC_URL=http://localhost:4000

# Comma-separated list of origins allowed to call the API (your deployed
# employee frontend URL, e.g. https://team-orbit.vercel.app). Use * only for
# local testing, never in production.
CORS_ORIGINS=*

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Seed / bootstrap super admin (created automatically on first boot if no
# users exist yet). Change the password before sharing the link with anyone.
BOOTSTRAP_SUPER_ADMIN_ID=SA-001
BOOTSTRAP_SUPER_ADMIN_PASSWORD=admin123

# Data mode: "memory" (dummy in-memory data, resets on restart) is the only
# mode implemented right now. It is structured so Phase 2 can swap in
# Supabase/PostgreSQL by rewriting only src/data/store.js.
DATA_MODE=memory
