# Copy this file to .env and adjust as needed.

# Server
PORT=4000
NODE_ENV=development

# Public URL of this backend once deployed (used only for logging/CORS hints)
PUBLIC_URL=http://localhost:4000

# Comma-separated list of origins allowed to call the API (your deployed
# employee frontend URL, e.g. https://team-orbit.vercel.app). Use * only for
# local testing, never in production.
CORS_ORIGINS=*

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Seed / bootstrap super admin (created automatically on first boot if no
# users exist yet). Change the password before sharing the link with anyone.
BOOTSTRAP_SUPER_ADMIN_ID=SA-001
BOOTSTRAP_SUPER_ADMIN_PASSWORD=admin123

# Supabase (Postgres) — required. Create a free project at supabase.com,
# run backend/supabase_schema.sql in its SQL Editor, then copy these two
# values from Project Settings -> API. SUPABASE_SERVICE_ROLE_KEY is secret —
# never expose it to the frontend or commit it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
