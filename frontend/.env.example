# Copy to .env for local dev if you want to override defaults.

# Set to "true" to use the old localStorage mock instead of the real backend
# (useful for offline UI work with no backend running). Defaults to false —
# the app talks to the real backend at /api via vite's dev proxy (see
# vite.config.js) or same-origin in production.
VITE_USE_MOCK=false
